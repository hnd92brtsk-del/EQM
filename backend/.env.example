DB_HOST=localhost
DB_PORT=5432
DB_NAME=equipment_crm
DB_USER=equipment_user
# Development placeholder only. Production must set a unique secret value.
DB_PASSWORD=change_me
# Development placeholder only. Production must set a unique secret value.
POSTGRES_SUPERUSER_PASSWORD=postgres_password_here

# Development placeholder only. Production must set a unique secret value at least 32 chars long.
JWT_SECRET=change_this_to_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ENV=development
# Можно перечислять несколько адресов через запятую.
CORS_ORIGINS=http://localhost:5173

UPLOAD_DIR=uploads
CABINET_FILES_DIR=storage/cabinet_files
CABINET_FILES_MAX_SIZE=10737418240
PHOTO_DIR=Photo
DATASHEET_DIR=Datasheets
PID_STORAGE_ROOT=app/pid_storage

PUBLIC_BASE_URL=
FRONTEND_PUBLIC_URL=
BACKEND_PUBLIC_URL=
FRONTEND_RUNTIME_HOST=localhost
FRONTEND_RUNTIME_PORT=5173
FRONTEND_RUNTIME_URL=
BACKEND_RUNTIME_HOST=localhost
BACKEND_RUNTIME_PORT=8000
BACKEND_RUNTIME_URL=

# Поддерживаются оба набора имён: LM_* и LLM_*.
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_API_KEY=
LM_MODEL=phi-3-mini-4k-instruct
LLM_ALLOWED_HOSTS=

SEED_ADMIN_USERNAME=admin
# Development placeholder only. Production will not start with this value.
SEED_ADMIN_PASSWORD=admin12345
ALLOW_ADMIN_PASSWORD_RESET=false
